{
  "name": "wechat-layout-harness",
  "version": "0.4.5",
  "state_model": "single-document-source-of-truth-with-optional-humanize-six-stage-workflow",
  "view_state_excluded": ["previewZoom", "selection"],
  "events": ["wechat-layout:changed"],  "methods": ["getState", "getWorkflowState", "applyText", "applyIntent", "importArticle", "humanizePreview", "humanizeApply", "humanizeSkip", "publishingWorkflow", "autoFormat", "getLayoutGuidance", "addImage", "selectBlock", "undo", "redo"],
  "supported_components": ["heading", "paragraph", "quote", "list", "table", "image", "cta", "gallery", "media"],
  "themes": ["minimal", "editorial", "fresh", "ink", "sunset", "official"],
  "humanizer_modes": ["natural", "conservative"],
  "import_model": {
    "text": "Markdown or plain text",
    "canonical_intermediate": "Markdown",
    "office_converter": "DOCX: Microsoft MarkItDown stream -> Markdown; fallback Mammoth HTML -> Turndown Markdown",
    "pdf_converter": "local PDF text extraction -> Markdown normalization",
    "auto_select_by_extension": true,
    "assets": "local image assets as data URLs",
    "preserves_original": true,
    "unmatched_images": "append_and_warn"
  },
  "max_history": 50,
  "core_content": {
    "type": "CoreContent",
    "version": 1,
    "source": "local-deterministic",
    "epistemic": "inference",
    "localOnly": true,
    "fields": ["thesis", "topic", "problem", "method", "conclusion", "keywords", "keySentences"],
    "evidence_sentence_types": ["TOPIC", "PROBLEM", "METHOD", "CONCLUSION"],
    "bodyRewritten": false,
    "requiresReview": true,
    "validator": "validateCoreContent"
  },
  "workflow": {
    "version": 2,
    "stages": ["recognize", "humanize", "distill", "layout", "review", "submit"],
    "optional_stages": ["humanize"],
    "humanize_contract": {
      "preview_changes_document": false,
      "apply_changes_document": true,
      "requires_human_confirmation": true,
      "invalidates_downstream": ["distill", "layout", "review", "submit"]
    },
    "evidence_ledger": "append-only-local",
    "remote_submit_requires_explicit_confirmation": true,
    "default_side_effect": "local-only"
  }
}
